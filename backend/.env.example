# ─── AI Career Advisor — backend environment ─────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Core ────────────────────────────────────────────────────────
# Must be False in any deployed environment. When False, /api/docs,
# /api/redoc and the OpenAPI schema are disabled, and SECRET_KEY becomes
# mandatory (the app refuses to start without it).
DEBUG=False

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing login session.
SECRET_KEY=

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────
# SQLite is fine for a demo. For a real deployment, point this at a managed
# Postgres instance, e.g.:
#   postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./career_advisor.db

# ── AI provider (optional — the app falls back to local heuristics) ──
# Only one of these is needed. If OPENROUTER_API_KEY is set it takes
# precedence over GEMINI_API_KEY.
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Storage ─────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Optional ─────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# SQL_ECHO=False
